# ---------------------------------------------------------------------------
# Oracle Autonomous Database
# ---------------------------------------------------------------------------
ORACLE_USER=ADMIN
# The ADMIN password for the database itself.
ORACLE_PASSWORD=
# An alias from tnsnames.ora in the wallet, not a name you choose. _high gives
# the connection the most resources and is right for the app; _low exists for
# bulk loads that should not crowd it out.
ORACLE_DSN=zspniy715u9q85u2_high
# Unzip the ADB wallet into this path inside the container and point TNS_ADMIN at it.
TNS_ADMIN=/app/wallet
# A DIFFERENT password: the one typed when downloading the wallet from OCI, not
# the database password above. python-oracledb runs in thin mode and reads
# ewallet.pem, which is an encrypted private key, so without this the pool fails
# to open with a TLS error that does not mention the wallet.
ORACLE_WALLET_PASSWORD=
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# ---------------------------------------------------------------------------
# OCI Generative AI. The only model service in the system.
# Models are addressed by OCID; GENAI_MODEL is carried for logs and the admin
# screen. The compartment is required: every call is billed against one.
#
# GENAI_REGION is deliberately set, not left to fall back to OCI_REGION. The
# tenancy home region is ap-mumbai-1 and that is where the database lives, but
# this model is served from us-chicago-1 and its OCID says so. Startup refuses
# to run if the two ever disagree, because the failure otherwise is a 404 on the
# model that names no region.
#
# The compartment below is the tenancy OCID, which is the root compartment.
# That is valid and means usage is billed at the root rather than to a project
# compartment.
# ---------------------------------------------------------------------------
GENAI_REGION=us-chicago-1
GENAI_MODEL=meta.llama-3.2-90b-vision-instruct
GENAI_MODEL_OCID=ocid1.generativeaimodel.oc1.us-chicago-1.amaaaaaask7dceya2xrydihzvu5pk6vlvfhtbnfapcvwhhugzo7jez4zcnaa
GENAI_COMPARTMENT_ID=ocid1.tenancy.oc1..aaaaaaaatznhqzbky6jdvflzkfvedppvrxbw4weyi2japj37aoagj6kcbfoa
# Optional: set only if a second model is provisioned for the polish pass.
# HARALD_POLISH_MODEL_OCID=
# Optional: overrides the derived https://inference.generativeai.<region>.oci.oraclecloud.com
# OCI_GENAI_ENDPOINT=
HARALD_LLM_CONCURRENCY=4
HARALD_LLM_MAX_RETRIES=5
HARALD_LLM_TIMEOUT=180

# ---------------------------------------------------------------------------
# OCI credentials. Leave these unset on a container that has a dynamic group
# and policy: instance or resource principals are picked up automatically.
# Set them to authenticate with an API key instead.
# ---------------------------------------------------------------------------
# OCI_CLI_USER=
# OCI_CLI_TENANCY=
# OCI_CLI_FINGERPRINT=
# OCI_CLI_KEY_CONTENT=
# The credential's own region. This is the tenancy home region, and it is not
# the same as GENAI_REGION above; signing works across regions.
# OCI_CLI_REGION=ap-mumbai-1

# ---------------------------------------------------------------------------
# Identity. The database has one shared login, so HARALD keeps its own.
# SESSION_SECRET signs session tokens. Approver is a role on the user roster,
# not a passphrase.
# ---------------------------------------------------------------------------
HARALD_SESSION_SECRET=
HARALD_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Object Storage. HARALD's own bucket for ERP proposals. This is a different
# bucket from SCOUT's, which holds resumes.
#
# The region is Mumbai, matching the tenancy and the database, and is NOT the
# Generative AI region. A client built for the wrong region reports a bucket
# that plainly exists as not found.
#
# Object Storage takes a namespace and a bucket NAME; there is no lookup by
# OCID, so the name is resolved once by listing the compartment and matching.
# ---------------------------------------------------------------------------
HARALD_BUCKET_OCID=ocid1.bucket.oc1.ap-mumbai-1.aaaaaaaaeh5hhalwfjmk5afmityikg3jjicckwiiao27ejsm45dlqt3i74nq
HARALD_BUCKET_REGION=ap-mumbai-1
HARALD_BUCKET_NAME=FRPStudio
# Only if the bucket is in a different compartment from the one billing model calls.
# HARALD_BUCKET_COMPARTMENT_ID=

# Private bucket that holds the ADB wallet zip for Container Instance startup.
# Never put the wallet in FRPStudio.
# HARALD_WALLET_BUCKET=harald-config
# HARALD_WALLET_OBJECT=wallet.zip
# TNS_ADMIN=/wallet

# ---------------------------------------------------------------------------
# Local embeddings. Baked into the image; no external service is called.
# ---------------------------------------------------------------------------
HARALD_EMBED_MODEL=BAAI/bge-base-en-v1.5
HARALD_EMBED_DIM=768

# ---------------------------------------------------------------------------
# Retrieval and export
# ---------------------------------------------------------------------------
HARALD_TOP_K=6
HARALD_STRONG_MATCH=0.35
HARALD_SOFFICE_BIN=soffice
HARALD_LOG_LEVEL=INFO
